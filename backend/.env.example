[TEMPLATE]
PORT=8080
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bhiv_core
JWT_SECRET=replace_with_a_long_random_secret
AUTH_SERVER_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,https://products.blackholeinfiverse.com,https://*.blackholeinfiverse.com

# ============================================
# PRAVESH (blackhole_auth) SSO CONFIGURATION
# ============================================
# Shared HS256 secret for signing Pravesh JWTs.
# Set this to the same value as blackhole_auth/backend/JWT_SECRET enable the SSO bridge.
PRAVESH_JWT_SECRET=replace_with_a_long_random_secret

# App slugs for each BHIV product (must match entries in backend/data/apps.json)
PRAVESH_APP_SLUG_gurukul=gurukul
PRAVESH_APP_SLUG_sampada=sampada
PRAVESH_APP_SLUG_hackaverse=hackaverse
PRAVESH_APP_SLUG_niyantran=niyantran
PRAVESH_APP_SLUG_blackhole=blackhole

# Cookie settings (must match across all products)
PRAVESH_COOKIE_NAME=blackhole_token
PRAVESH_REQUIRE_APP_CLAIM=false

# Sampada gateway URL for identity resolution (used by Pravesh bridge)
SAMPADA_IDENTITY_URL=http://localhost:8000/api/v1/identity/candidate/
SAMPADA_API_KEY=replace_with_sampada_gateway_api_key

# HackaVerse enrolment URL
HACKAVERSE_ENROLMENT_URL=http://localhost:8100/enrolment/ingest
# X-API-Key accepted by HackaVerse (the API_KEY in hackathon/.env)
HACKAVERSE_ENROLMENT_API_KEY=replace_with_hackaverse_api_key

# Niyantran bridge configuration
NIYANTRAN_BASE_URL=http://localhost:5000/api